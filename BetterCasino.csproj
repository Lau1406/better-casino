<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BetterCasino</AssemblyName>
    <RootNamespace>BetterCasino</RootNamespace>
    <Version>4.0.0</Version>
    <Authors>Zyhloh</Authors>
    <Description>Better Casino mod for Schedule I</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <LibsDir>$(MSBuildProjectDirectory)\..\Libs</LibsDir>
    <ModManagerDir>$(MSBuildProjectDirectory)\..\ModManager</ModManagerDir>
    <DefaultItemExcludes>$(DefaultItemExcludes);GameDump\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(LibsDir)\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(LibsDir)\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(LibsDir)\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(LibsDir)\Il2CppAssemblies\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(LibsDir)\Il2CppAssemblies\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(LibsDir)\Il2CppAssemblies\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(LibsDir)\Il2CppAssemblies\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(LibsDir)\Il2CppAssemblies\Il2CppFishNet.Runtime.dll" Private="false" />
    <Reference Include="$(LibsDir)\Il2CppAssemblies\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(ModManagerDir)\ModManager&amp;PhoneApp.dll" Private="false" />
  </ItemGroup>

</Project>
